# Required before starting Docker Compose
JWT_SECRET_KEY=replace-with-a-long-random-secret

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=subscription_saas

# Host ports
FRONTEND_PORT=3001
BACKEND_PORT=8001
POSTGRES_PORT=5433
FRONTEND_URL=http://localhost:3001

# Optional Microsoft Entra / Azure integration
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT=common
AZURE_REDIRECT_URI=http://localhost:3001/api/integrations/azure/oauth/callback
AZURE_SCOPES=https://management.azure.com/user_impersonation
AZURE_TOKEN_ENCRYPTION_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6

# Notifications (Email & WhatsApp for Smart Renewal Alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@unisora.in
SMTP_TLS=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ---- Production (unisora.in) -- put these in the server's .env ----
# FRONTEND_URL=https://unisora.in
# AZURE_REDIRECT_URI=https://unisora.in/api/integrations/azure/oauth/callback
# JWT_SECRET_KEY=<long random string: openssl rand -hex 32>
# POSTGRES_PASSWORD=<strong password>
