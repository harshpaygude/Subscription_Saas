APP_NAME=Unified Cloud Platform
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg://platform:platform@localhost:5432/platform
VITE_API_BASE_URL=http://localhost:8000

# Microsoft Entra / Azure Resource Manager (server-side only)
AZURE_CLIENT_ID=replace-with-app-registration-client-id
AZURE_CLIENT_SECRET=replace-with-server-side-secret
AZURE_TENANT=common
AZURE_REDIRECT_URI=http://localhost:8000/api/azure/oauth/callback
AZURE_SCOPES=https://management.azure.com/user_impersonation
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AZURE_TOKEN_ENCRYPTION_KEY=replace-with-fernet-key
PLATFORM_USER_HEADER=X-Platform-User-ID
# Development only; production always requires the receiving platform identity.
ALLOW_LOCAL_PLATFORM_USER_HEADER=true
AZURE_DEV_IDENTITY_COOKIE=azure_dev_identity
# Development only; never enable in production. Token remains backend memory only.
ENABLE_MANUAL_AZURE_TOKEN_INPUT=false

# Provider credentials will be added only with their provider-specific implementation.
# Never expose backend secrets through VITE_* variables.
