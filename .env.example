# Required before starting Docker Compose
JWT_SECRET_KEY=replace-with-a-long-random-secret

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=subscription_saas

# Host ports
FRONTEND_PORT=3001
BACKEND_PORT=8001
POSTGRES_PORT=5433
FRONTEND_URL=http://localhost:3001

# Optional Microsoft Entra / Azure integration
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT=common
AZURE_REDIRECT_URI=http://localhost:3001/api/integrations/azure/oauth/callback
AZURE_SCOPES=https://management.azure.com/user_impersonation
AZURE_TOKEN_ENCRYPTION_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6
