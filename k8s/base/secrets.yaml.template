# ============================================================
# UNISORA SECRETS TEMPLATE
# ============================================================
# DO NOT commit real values. Fill in and apply manually:
#   kubectl apply -f k8s/base/secrets.yaml
# Or use: kubectl create secret generic unisora-secrets \
#   --from-env-file=.env.production -n unisora
# ============================================================
apiVersion: v1
kind: Secret
metadata:
  name: unisora-secrets
  namespace: unisora
type: Opaque
stringData:
  # PostgreSQL credentials
  POSTGRES_USER: "postgres"
  POSTGRES_PASSWORD: "CHANGE_ME_STRONG_PASSWORD"
  POSTGRES_DB: "subscription_saas"

  # Must match POSTGRES_* above — full connection string
  DATABASE_URL: "postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@postgres:5432/subscription_saas"

  # JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
  JWT_SECRET_KEY: "CHANGE_ME_GENERATE_RANDOM_64_CHARS"

  # Azure (optional — leave blank if not using Azure integration)
  AZURE_CLIENT_ID: ""
  AZURE_CLIENT_SECRET: ""
  AZURE_TOKEN_ENCRYPTION_KEY: ""
