APP_NAME=Subscription Management SaaS
APP_VERSION=0.1.0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/subscription_saas
JWT_SECRET_KEY=replace-me
JWT_ALGORITHM=HS256

# ARN of the dedicated UniSora backend role customers trust.
AWS_BACKEND_ROLE_ARN=arn:aws:iam::<UniSora-backend-account>:role/UniSoraBackendIntegration
AWS_REGION=us-east-1
# Optional local bootstrap profile used only to assume AWS_BACKEND_ROLE_ARN.
AWS_BOOTSTRAP_PROFILE=
AWS_ROLE_SESSION_DURATION_SECONDS=900
