# UniSora Microservices Platform Environment Configuration

# Shared Database Host Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=subscription_saas
POSTGRES_PORT=5432

# Public Entrypoint Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Security & Service-to-Service Trust
JWT_SECRET_KEY=replace-with-a-random-32-byte-secret
JWT_ALGORITHM=HS256
INTERNAL_SERVICE_SECRET=replace-with-a-random-internal-hmac-secret
ENVIRONMENT=development
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=600

# Frontend Origin
FRONTEND_URL=http://127.0.0.1:3000

# External Provider Integrations (Integration Service)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT=common
AZURE_REDIRECT_URI=http://127.0.0.1:8000/integrations/azure/oauth/callback
AZURE_SCOPES=https://management.azure.com/user_impersonation
AZURE_TOKEN_ENCRYPTION_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6
