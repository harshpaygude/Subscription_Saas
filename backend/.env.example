DATABASE_URL=postgresql://postgres:postgres@localhost:5432/subscription_saas
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256

# Browser-facing local frontend and same-origin API proxy
FRONTEND_URL=http://127.0.0.1:3000

# Microsoft Entra app registration. Register this exact redirect URI.
AZURE_CLIENT_ID=replace-with-entra-application-client-id
AZURE_CLIENT_SECRET=replace-with-entra-client-secret
AZURE_TENANT=common
AZURE_REDIRECT_URI=http://127.0.0.1:3000/api/integrations/azure/oauth/callback
AZURE_SCOPES=https://management.azure.com/user_impersonation
AZURE_TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key

# Anthropic is configured per organization through the UI; this only controls
# the default model shown by deployments that choose to use it.
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6
